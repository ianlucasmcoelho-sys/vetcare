# ==============================================================================
# VetCare - Variáveis de Ambiente para Produção (.env)
# ==============================================================================

# Ambiente de Execução
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=1

# URLs da Aplicação (Seu Domínio)
FRONTEND_URL=https://seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Segurança JWT (Gere uma chave aleatória forte de 64 caracteres, ex: openssl rand -hex 32)
JWT_SECRET=sua_chave_jwt_super_secreta_e_forte_aqui

# Inteligência Artificial (Google Gemini API)
GEMINI_API_KEY=sua_chave_gemini_api_key_aqui

# Pagamentos Asaas: valide primeiro no Sandbox (conta independente).
# Chave e token do webhook são obrigatórios; nunca envie os valores para o frontend.
# Produção: ASAAS_API_URL=https://api.asaas.com/v3 + chave da conta de produção.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_EMAIL=alertas@seudominio.com.br
ASAAS_WEBHOOK_URL=https://seudominio.com.br/api/asaas/webhook
# Configuração e homologação: docs/pagamentos-asaas.md

# Integração Stripe descontinuada. Configure somente Asaas.

# Serviço de E-mail SMTP (Para recuperação de senha e notificações)
# Exemplo com Gmail (use "Senha de App" de 16 letras) ou SendGrid / Resend:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@clinica.com.br
SMTP_PASS=sua_senha_de_app_de_16_digitos

# Banco de Dados (Obrigatório em produção; PostgreSQL gerenciado recomendado)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco
PGSSL=true
# Opcional quando o provedor usa uma CA que não está no trust store do Node.
# Obtenha o certificado raiz nas configurações SSL do banco e armazene em base64.
# PGSSL_CA_BASE64=

# Integração privada somente leitura com VetCare Gestão. Gere 32 bytes aleatórios.
# Configure o mesmo segredo como MANAGEMENT_SOURCE_TOKEN no servidor da gestão.
# Não reutilizar JWT_SECRET, token de webhook ou credenciais de usuários.
COMPANY_API_TOKEN=
