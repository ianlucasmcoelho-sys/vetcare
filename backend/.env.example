# ==============================================================================
# VetCare - Variáveis de Ambiente para Produção (.env)
# ==============================================================================

# Ambiente de Execução
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=1

# URLs da Aplicação (Seu Domínio)
FRONTEND_URL=https://seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Segurança JWT (Gere uma chave aleatória forte de 64 caracteres, ex: openssl rand -hex 32)
JWT_SECRET=sua_chave_jwt_super_secreta_e_forte_aqui

# Inteligência Artificial (Google Gemini API)
GEMINI_API_KEY=sua_chave_gemini_api_key_aqui

# Gateway de Pagamento Asaas (Produção)
# Para produção: use https://api.asaas.com/v3 e gere a chave no painel oficial do Asaas
ASAAS_API_KEY=$aact_prod_sua_chave_de_producao_aqui
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=defina_um_token_secreto_para_o_webhook_asaas

# Gateway de Pagamento Stripe (Opcional se usar apenas Asaas)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Serviço de E-mail SMTP (Para recuperação de senha e notificações)
# Exemplo com Gmail (use "Senha de App" de 16 letras) ou SendGrid / Resend:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@clinica.com.br
SMTP_PASS=sua_senha_de_app_de_16_digitos

# Banco de Dados (Obrigatório em produção; PostgreSQL gerenciado recomendado)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco
PGSSL=true
# Opcional quando o provedor usa uma CA que não está no trust store do Node.
# Obtenha o certificado raiz nas configurações SSL do banco e armazene em base64.
# PGSSL_CA_BASE64=
