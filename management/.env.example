# Configure variáveis na aplicação separada da Hostinger. Nunca reutilize o banco clínico.
NODE_ENV=production
PORT=3010
MANAGEMENT_ORIGIN=https://gestao.vetcaresistema.com
# API privada do sistema clínico; o segredo só fica nos servidores.
MANAGEMENT_SOURCE_URL=https://vetcaresistema.com
MANAGEMENT_SOURCE_TOKEN=
# PostgreSQL exclusivo do painel; obrigatório em produção.
MANAGEMENT_DATABASE_URL=
MANAGEMENT_PGSSL=true
# Opcional: certificado CA do provedor em base64 (verificação TLS sempre ativa).
MANAGEMENT_PGSSL_CA_BASE64=
# Configure somente se houver exatamente um proxy reverso confiável na frente do Node.
MANAGEMENT_TRUST_PROXY=1
# Desenvolvimento local: banco SQLite exclusivo. Nunca usar clinica.db.
# MANAGEMENT_SQLITE_PATH=./data/management.sqlite
